    "react-dom": "^18",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4.4.1",
    "prettier": "3.0.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
